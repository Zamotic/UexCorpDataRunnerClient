<UserControl x:Class="UexCorpDataRunner.Presentation.DataRunnerV2.CommodityUpdaterTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UexCorpDataRunner.Presentation.DataRunnerV2"
             xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sort="clr-namespace:UexCorpDataRunner.Presentation.DataRunnerV2.Sort"
             xmlns:filter="clr-namespace:UexCorpDataRunner.Presentation.DataRunnerV2.Filter"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="505">
    <UserControl.Resources>
        <Thickness x:Key="innerMargin">2,2</Thickness>
        <CollectionViewSource x:Key="BuyableCommodityListCVS" Source="{Binding Commodities}">
            <Behaviors:Interaction.Behaviors>
                <filter:BuyableCommodityListFilter />
                <sort:CommoditySort />
            </Behaviors:Interaction.Behaviors>
        </CollectionViewSource>
        <CollectionViewSource x:Key="SellableCommodityListCVS" Source="{Binding Commodities}">
            <Behaviors:Interaction.Behaviors>
                <filter:SellableCommodityListFilter />
                <sort:CommoditySort />
            </Behaviors:Interaction.Behaviors>
        </CollectionViewSource>
    </UserControl.Resources>
    <TabControl
        Margin="{StaticResource innerMargin}"
        DockPanel.Dock="Top"
        Style="{StaticResource Style-TabControl-Main}"
        TabIndex="0"
        SelectedIndex="{Binding SelectedTabItemIndex}"
        SelectionChanged="TabControl_SelectionChanged">
        <TabItem
            Header="Buy Price">
            <DockPanel
                Background="{DynamicResource primaryControlBackgroundBrush}">
                <Grid
                    Margin="0,0,16,0"
                    DockPanel.Dock="Top"
                    Height="25">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource newPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource scuColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource statusColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource minPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource maxPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource submitColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="New"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Supply"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Status"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="3"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Min"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="4"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Max"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="5"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Submit?"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                </Grid>
                <ScrollViewer
                    DockPanel.Dock="Top"
                    Name="BuyTabScrollViewer"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Source={StaticResource BuyableCommodityListCVS}}"
                        ItemTemplate="{StaticResource itemsControlItemTemplateV2}"
                        HorizontalAlignment="Left"
                        Width="{StaticResource itemsControlWidth}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Source={StaticResource BuyableCommodityListCVS}}"
                                        Value="{x:Null}">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding Source={StaticResource BuyableCommodityListCVS}}"
                                        Value="0">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem
            Header="Sell Price">
            <DockPanel
                Background="{DynamicResource primaryControlBackgroundBrush}">
                <Grid
                    Margin="0,0,16,0"
                    DockPanel.Dock="Top"
                    Height="25">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource newPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource scuColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource statusColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource minPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource maxPriceColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource submitColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="New"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Supply"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="2"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Status"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="3"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Min"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="4"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Max"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="5"
                        Padding="5"
                        BorderThickness=".25"
                        BorderBrush="{DynamicResource gridBorderBrush}">
                        <TextBlock
                            Text="Submit?"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource textForegroundBrush}" />
                    </Border>
                </Grid>
                <ScrollViewer
                    Name="SellTabScrollViewer"
                    DockPanel.Dock="Top"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Source={StaticResource SellableCommodityListCVS}}"
                        ItemTemplate="{StaticResource itemsControlItemTemplateV2}"
                        HorizontalAlignment="Left"
                        Width="{StaticResource itemsControlWidth}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Source={StaticResource SellableCommodityListCVS}}"
                                        Value="{x:Null}">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding Source={StaticResource SellableCommodityListCVS}}"
                                        Value="0">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
