<UserControl x:Class="UexCorpDataRunner.Presentation.DataRunnerV2.CommodityUpdaterTabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UexCorpDataRunner.Presentation.DataRunnerV2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid
        Margin="0,0,16,0"
        Height="25">
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource newPriceColumnWidth}" />
            <ColumnDefinition Width="{StaticResource scuColumnWidth}" />
            <ColumnDefinition Width="{StaticResource statusColumnWidth}" />
            <ColumnDefinition Width="{StaticResource minPriceColumnWidth}" />
            <ColumnDefinition Width="{StaticResource maxPriceColumnWidth}" />
            <ColumnDefinition Width="{StaticResource submitColumnWidth}" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Padding="2"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="New"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Padding="2"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="Supply"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="2"
            Padding="2"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="Status"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="3"
            Padding="5"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="Min"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="4"
            Padding="5"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="Max"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="5"
            Padding="5"
            BorderThickness=".25"
            BorderBrush="{DynamicResource gridBorderBrush}">
            <TextBlock
                Text="Submit?"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource textForegroundBrush}" />
        </Border>
    </Grid>
</UserControl>
